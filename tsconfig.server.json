{
  // Type checks the server's JavaScript (src/server, src/core and what they load) from its JSDoc,
  // without building anything: npm run typecheck:server (npm test runs it too). Not strict yet.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/core/**/*.js", "src/server/**/*.js"]
}
